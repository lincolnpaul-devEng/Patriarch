<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- No cleartext HTTP anywhere; system CAs only (user-installed MITM CAs are not trusted). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- TODO: add <pin-set> for the Supabase and Stream hosts once their SPKI hashes are captured. -->
</network-security-config>
